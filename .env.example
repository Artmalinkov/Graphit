# ================================
# PostgreSQL
# ================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=graphite_db
DB_USER=postgres
DB_PASSWORD=your_password

# ================================
# Пути
# ================================
# Путь к вашему хранилищу Obsidian (используйте / или \\)
OBSIDIAN_PATH=D:/00.Основное/02.Obsidian/My_mind/Obsidian_socnet

# ================================
# Настройки приложения
# ================================
LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR
BATCH_SIZE=100                    # Размер батча для вставки в БД

# ================================
# Настройки визуализации
# ================================
GRAPH_WIDTH=1200                  # Ширина графа (px)
GRAPH_HEIGHT=800                  # Высота графа (px)